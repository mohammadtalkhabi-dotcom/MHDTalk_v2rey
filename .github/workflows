name: SUBTEXT2

on:
  workflow_dispatch:
  schedule:
    - cron: "0 */2 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install jq
        run: sudo apt-get update && sudo apt-get install -y jq

      - name: Download subscription
        run: |
          curl -fL "https://raw.githubusercontent.com/Epodonios/v2ray-configs/main/All_Configs_Sub.txt" -o all.txt
          echo "📥 تعداد کل: $(wc -l < all.txt)"

      - name: Extract Netherlands configs
        run: |
          set +e

          # استخراج تمام IPهای موجود در فایل
          grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' all.txt | sort -u > unique_ips.txt
          echo "🌐 تعداد IP یکتا: $(wc -l < unique_ips.txt)"

          # تشخیص کشور تمام IPها
          > country_map.txt

          if [ -s unique_ips.txt ]; then
            split -l 100 unique_ips.txt chunk_

            for chunk in chunk_*; do
              json=$(jq -R . < "$chunk" | jq -s .)

              response=$(curl -s -X POST "http://ip-api.com/batch" \
                -H "Content-Type: application/json" \
                -d "$json")

              if echo "$response" | jq -e . >/dev/null 2>&1; then
                echo "$response" | jq -r \
                  '.[] | select(.status == "success") | "\(.query)|\(.country)"' \
                  >> country_map.txt
              fi

              sleep 0.2
            done

            rm -f chunk_*
          fi

          echo "🗺️ کشورها شناسایی شدند"

          # فقط کانفیگ‌های Netherlands
          > netherlands.txt

          while IFS= read -r line; do
            [ -z "$line" ] && continue

            ip=$(echo "$line" | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -1)

            if [ -n "$ip" ]; then
              country=$(grep "^$ip|" country_map.txt | cut -d'|' -f2 | head -1)

              if [ "$country" = "Netherlands" ]; then
                echo "$line" >> netherlands.txt
              fi
            fi
          done < all.txt

          echo "🇳🇱 تعداد کانفیگ‌های Netherlands پیدا شده: $(wc -l < netherlands.txt)"

      - name: Pick 200 random Netherlands configs
        run: |
          shuf netherlands.txt | head -n 200 > selected.txt

          echo "📄 تعداد انتخاب شده: $(wc -l < selected.txt)"

      - name: Rename configs Netherlands 1 to 200
        run: |
          > SUBTEXT2
          count=1

          while IFS= read -r line; do
            [ -z "$line" ] && continue

            name="Netherlands $count"

            # vmess
            if [[ "$line" == vmess://* ]]; then
              encoded="${line#vmess://}"
              decoded=$(echo "$encoded" | base64 -d 2>/dev/null || echo "")

              if [ -n "$decoded" ] && echo "$decoded" | jq -e . >/dev/null 2>&1; then
                new_decoded=$(echo "$decoded" | jq --arg name "$name" '.ps = $name')
                new_encoded=$(echo "$new_decoded" | base64 -w 0)
                echo "vmess://$new_encoded" >> SUBTEXT2
              else
                echo "${line%%#*}#${name}" >> SUBTEXT2
              fi

            # سایر پروتکل‌ها
            else
              if [[ "$line" == *"#"* ]]; then
                echo "$line" | sed "s/#[^#]*$/#$name/" >> SUBTEXT2
              else
                echo "${line}#${name}" >> SUBTEXT2
              fi
            fi

            count=$((count + 1))
          done < selected.txt

          echo "✅ تعداد نهایی: $(wc -l < SUBTEXT2)"
          echo "📋 نمونه:"
          head -n 5 SUBTEXT2

      - name: Cleanup
        run: |
          rm -f all.txt unique_ips.txt country_map.txt netherlands.txt selected.txt

      - name: Commit and push
        run: |
          git config user.name "github-actions"
          git config user.email "github-actions@github.com"

          git add SUBTEXT2

          if git diff --cached --quiet; then
            echo "✅ بدون تغییر"
            exit 0
          fi

          git commit -m "Update 200 Netherlands configs"
          git push
